# Normalize text files to LF in the repository, checked out native on each machine.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.props     text
*.json      text
*.md        text
*.sql       text
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.pfx binary
*.snk binary
